cabal-version: 3.0
name: dipl
version: 0.1.0.0
license: NONE
build-type: Simple

common warnings
  ghc-options: -Wall

library
  import: warnings
  exposed-modules:
    AlgorithmW
    AlgorithmW.Expr
    AlgorithmW.Inference
    AlgorithmW.Parser
    AlgorithmW.Type
    Parser
    -- SystemF
    -- SystemF.Error
    -- SystemF.Expr
    -- SystemF.Type
    -- ToText
    Utils

  build-depends:
    base ^>=4.18.3.0,
    containers,
    transformers,

  hs-source-dirs: src
  default-language: Haskell2010

executable dipl
  import: warnings
  main-is: Main.hs
  build-depends:
    base ^>=4.18.3.0,
    dipl,

  hs-source-dirs: app
  default-language: Haskell2010
